{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "clapslearn-logs",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-23",
    "upload_source_maps": true,
    "observability": {
        "enabled": true
    },
    "containers": [
        {
            "class_name": "LaravelContainer",
            "scheduling_policy": "durable_object",
            "images": {
                "base": {
                    "dockerfile": "./Dockerfile.cloudflare"
                }
            }
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "LARAVEL_CONTAINER",
                "class_name": "LaravelContainer"
            }
        ]
    },
    "exports": {
        "LaravelContainer": {
            "type": "durable-object",
            "storage": "sqlite"
        }
    },
    "vars": {
        "DB_PORT": "3306"
    },
    "secrets": {
        "required": [
            "APP_KEY",
            "APP_URL",
            "DB_HOST",
            "DB_DATABASE",
            "DB_USERNAME",
            "DB_PASSWORD",
            "GOOGLE_CREDENTIALS_BASE64",
            "AWS_ACCESS_KEY_ID",
            "AWS_SECRET_ACCESS_KEY",
            "R2_ACCOUNT_ID",
            "R2_BUCKET_NAME"
        ]
    }
}
