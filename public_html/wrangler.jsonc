{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "clapslearn-logs",
    "account_id": "74ad8d10da1568cedacdd379a246cefc",
    "routes": [
        {
            "pattern": "erp.clapslearn.in",
            "custom_domain": true
        }
    ],
    "main": "src/index.ts",
    "services": [{ "binding": "STORAGE_GATEWAY", "service": "clapslearn-logs", "entrypoint": "StorageGateway" }],
    "assets": { "directory": "./.cloudflare-assets", "not_found_handling": "none" },
    "compatibility_date": "2026-10-23",
    "upload_source_maps": true,
    "triggers": { "crons": ["*/5 * * * *"] },
    "observability": {
        "enabled": true
    },
    "containers": [
        {
            "class_name": "LaravelContainer",
            "scheduling_policy": "durable_object",
            "observability": { "enabled": true },
            "images": {
                "base": {
                    "dockerfile": "./Dockerfile.cloudflare"
                }
            }
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "LARAVEL_CONTAINER",
                "class_name": "LaravelContainer"
            }
        ]
    },
    "exports": {
        "LaravelContainer": {
            "type": "durable-object",
            "storage": "sqlite"
        }
    },
    "vars": {
        "APP_URL": "https://erp.clapslearn.in"
    },
    "secrets": {
        "required": [
            "APP_KEY",
            "INTERNAL_TOKEN"
        ]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "clapslearn-erp",
            "database_id": "6056c8ae-89d3-4cea-a075-0d3bb8d79200",
            "migrations_dir": "cloudflare/migrations"
        }
    ],
    "r2_buckets": [
        {
            "binding": "UPLOADS",
            "bucket_name": "clapslearn-erp-uploads"
        }
    ]
}
