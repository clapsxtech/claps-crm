  erp_enrollments ||..o{ erp_marks : "enrollment_id"
  erp_demos |o..o{ erp_allocation_requests : "demo_id"
  erp_enrollments |o..o{ erp_allocation_requests : "enrollment_id"
  erp_agreements |o..o{ erp_allocation_requests : "agreement_id"
  erp_enrollments |o..o{ erp_demos : "enrollment_id"
  erp_agreements |o..o{ erp_demos : "agreement_id"
