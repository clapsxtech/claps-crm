.DS_Store
Thumbs.db

# Laravel environment & credentials
.env
.env.*
*.env
*.key
credentials.json
*/credentials.json
public_html/storage/credentials.json

# Dependencies
vendor/
node_modules/
public_html/vendor/
public_html/node_modules/

# Logs and cache
*.log
public_html/storage/logs/*
!public_html/storage/logs/.gitignore
public_html/storage/framework/cache/*
public_html/storage/framework/sessions/*
!public_html/storage/framework/sessions/.gitignore
public_html/storage/framework/views/*
!public_html/storage/framework/views/.gitignore

# Local verification artifacts and generated Laravel manifests
public_html/.phpunit.cache/
public_html/phpunit.xml.bak
public_html/bootstrap/cache/*
!public_html/bootstrap/cache/.gitignore
# Licensed, explicitly reviewed frontend distributions (not Composer vendor)
!public_html/resources/vendor/
!public_html/resources/vendor/**

# Local deployment output, snapshots and screenshots
.wrangler/
.cloudflare-assets/
artifacts/
__pycache__/
*.pyc
*.sqlite
*.sqlite-*
*.db
public_html/storage/app/*
!public_html/storage/app/.gitignore
public_html/storage/framework/testing/
public_html/public/uploads/
